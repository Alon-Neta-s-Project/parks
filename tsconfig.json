{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "apps/web/src",
    "apps/server/src",
    "apps/server/netlify",
    "apps/server/vitest.config.ts",
    "apps/pipeline/src",
    "apps/pipeline/vitest.config.ts",
    "scripts",
    "apps/web/vite.config.ts",
    "apps/web/vite.tim.config.ts",
    "apps/web/vite.tim-test.config.ts"
  ]
}
