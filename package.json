{
  "name": "park-day-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:server": "npm -w apps/server run dev",
    "build:server": "npm -w apps/server run build",
    "docker:server": "docker build -f apps/server/Dockerfile -t park-server .",
    "golden": "tsx --env-file=.env.server scripts/run-golden.ts",
    "db:local-pg": "bash scripts/db-local-pg.sh",
    "db:status": "DBMATE_MIGRATIONS_DIR=apps/server/db/migrations DBMATE_MIGRATIONS_TABLE=dbmate_migrations dbmate status",
    "db:new": "DBMATE_MIGRATIONS_DIR=apps/server/db/migrations dbmate new",
    "build": "tsc -b && vite build --config apps/web/vite.config.ts && tsx scripts/prerender.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "test": "vitest run --config apps/web/vite.config.ts && vitest run --config apps/server/vitest.config.ts && npm run test:edge",
    "test:edge": "vitest run --config supabase/functions/vitest.config.ts",
    "import": "tsx scripts/import-content.ts",
    "artifact": "npm run build && python3 scripts/build-artifact.py",
    "build:tim": "python3 scripts/build-tim-prompt.py --check && tsc -b && vite build --config apps/web/vite.tim.config.ts && tsx scripts/verify-tim-build.ts",
    "qa": "bash scripts/qa-gate.sh",
    "build:tim-test": "tsc -b && vite build --config apps/web/vite.tim-test.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  }
}
