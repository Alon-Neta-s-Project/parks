# Supabase — client side only.
#
# The anon key is public by design: it ships inside every browser bundle, and
# nothing about it is secret. What protects the data is row-level security, so
# before this key goes anywhere, apps/server/db/local/rls-audit.sql must pass against that
# project. Verified locally: content is readable, and profile, trip, trip_member
# and conversation are invisible to anon while their owner sees them.
#
# service_role must NEVER appear here or anywhere in the client (brief §9.1).
# It belongs only in an Edge Function's server-side environment.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave both unset to run entirely from the bundled dataset, which is the
# default and what the published preview uses.
